#!/bin/bash

# Load from .bashrc with:
#   [[ -f ~/.hdfrc ]] && . ~/.hdfrc

[[ $- == *i* ]] || return
command -v hdf > /dev/null || return

__hdf_search() {
  local line status
  local -a options=(--print-query)

  # hdf shows the prompt bash just cleared, ${PS1@P} needs bash 4.4
  if (( BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 404 )); then
    options+=(--prompt "${PS1@P}")
  fi

  history -a
  # HISTFILE isn't exported by default
  line=$(HISTFILE=${HISTFILE} hdf "${options[@]}" -- "${READLINE_LINE}")
  status=$?

  # 0: picked command, 3: query left with Esc; anything else keeps the line
  if (( status == 0 || status == 3 )) && [[ ${line} != "${READLINE_LINE}" ]]; then
    READLINE_LINE=${line}
    READLINE_POINT=${#line}
  fi
}

# Page Up / Page Down search history with hdf.
bind -x '"\e[5~": __hdf_search'
bind -x '"\e[6~": __hdf_search'
