#!/bin/bash

# Load from .bashrc with:
#   [[ -f ~/.hdfrc ]] && . ~/.hdfrc

[[ $- == *i* ]] || return
command -v hdf > /dev/null || return

__hdf_search() {
  local line status

  history -a
  # HISTFILE isn't exported by default
  line=$(HISTFILE=${HISTFILE} hdf --print-query -- "${READLINE_LINE}")
  status=$?

  # 0: picked command, 3: query left with Esc; anything else keeps the line
  if (( status == 0 || status == 3 )) && [[ ${line} != "${READLINE_LINE}" ]]; then
    READLINE_LINE=${line}
    READLINE_POINT=${#line}
  fi
}

# Page Up / Page Down search history with hdf.
bind -x '"\e[5~": __hdf_search'
bind -x '"\e[6~": __hdf_search'
