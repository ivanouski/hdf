#!/bin/bash

# Up and Down open hdf with the typed text as the query: Enter and Tab put the chosen command on the
# line, Esc puts the query back as edited there, Ctrl-C leaves the line as it was, Ctrl-D deletes
# commands from history. Stowed to ~/.hdfrc, load it in .bashrc with:
#   [[ -f ~/.hdfrc ]] && . ~/.hdfrc
#
# Deleted commands leave this shell's history at the next prompt when PROMPT_COMMAND reloads it
# (history -a; history -c; history -r). Reloading here would clash with readline, which writes
# the edited line back over a history entry when the binding returns.

# Key bindings need an interactive shell, and hdf itself
[[ $- == *i* ]] || return
command -v hdf > /dev/null || return

__hdf_search() {
  local line status

  # Save this shell's new commands first so they can be found
  history -a

  line=$(HISTFILE=${HISTFILE} hdf --print-query -- "${READLINE_LINE}")
  status=$?

  # 0 prints the picked command, 3 the query left with Esc. Anything else leaves the line as it
  # was: Ctrl-C (130), errors (2), and an hdf too old for --print-query, which fails with 1.
  # An unchanged line keeps the cursor where it was.
  if (( status == 0 || status == 3 )) && [[ ${line} != "${READLINE_LINE}" ]]; then
    READLINE_LINE=${line}
    READLINE_POINT=${#line}
  fi
}

bind -x '"\e[A": __hdf_search'
bind -x '"\eOA": __hdf_search'
bind -x '"\e[B": __hdf_search'
bind -x '"\eOB": __hdf_search'
