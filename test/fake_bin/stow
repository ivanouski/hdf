#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true

# Stands in for stow in tests: logs the working directory and arguments of each call to $FAKE_STOW_LOG,
# prints $FAKE_STOW_OUTPUT to stderr like stow --verbose, and fails when the package is $FAKE_STOW_FAIL.

require 'json'

File.open(ENV.fetch('FAKE_STOW_LOG'), 'a') { |file| file.puts(JSON.generate([Dir.pwd, *ARGV])) }

warn(ENV['FAKE_STOW_OUTPUT']) if ENV['FAKE_STOW_OUTPUT']

package = ARGV.find { |arg| !arg.start_with?('-') }

exit(package == ENV['FAKE_STOW_FAIL'] ? 1 : 0)
