#!/usr/bin/env -S ruby --disable-gems
# frozen_string_literal: true

# Stands in for cargo in tests: logs the working directory and arguments of each call to $FAKE_CARGO_LOG,
# and fails when $FAKE_CARGO_FAIL is set.

require 'json'

File.open(ENV.fetch('FAKE_CARGO_LOG'), 'a') { |file| file.puts(JSON.generate([Dir.pwd, *ARGV])) }

exit(ENV['FAKE_CARGO_FAIL'] ? 1 : 0)
