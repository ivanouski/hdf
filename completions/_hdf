#!/bin/bash

_hdf() {
  local current="${COMP_WORDS[COMP_CWORD]}"
  local word index print_query="" prompt=""
  local -a candidates=()

  for (( index = 1; index < COMP_CWORD; index++ )); do
    word="${COMP_WORDS[index]}"
    case "${word}" in
      # Everything after -- is the query, and these exit before searching
      --|-h|--help|-V|--version|--init-config|--delete-last)
        COMPREPLY=()
        return 0
        ;;
      --print-query) print_query=1 ;;
      --prompt)
        prompt=1
        # The prompt text is free text, whatever it looks like
        if (( ++index == COMP_CWORD )); then
          COMPREPLY=()
          return 0
        fi
        ;;
    esac
  done

  # Other words are the query, free text
  case "${current}" in
    --*)
      [[ -z "${print_query}" ]] && candidates+=(--print-query)
      [[ -z "${prompt}" ]] && candidates+=(--prompt)
      (( COMP_CWORD == 1 )) && candidates+=(--delete-last --init-config --help --version)
      ;;
    -*) (( COMP_CWORD == 1 )) && candidates+=(-h -V) ;;
  esac

  COMPREPLY=( $(compgen -W "${candidates[*]}" -- "${current}") )

  return 0
}

complete -F _hdf hdf
